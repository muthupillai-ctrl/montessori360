# Deployment target: the home Linux server (Docker Compose + shared reverse-proxy).
# Copy to scripts/deploy.env and edit. deploy.env is gitignored.

SERVER=pwms-server                      # Host alias from ~/.ssh/config
REMOTE_BASE=/data/apps/montessori360    # compose.yaml, api/, ams-api/, web/www, ams-web/www
REVERSE_PROXY_DIR=/data/reverse-proxy   # shared nginx container's compose + conf.d
REVERSE_PROXY_CONTAINER=reverse-proxy

# Public hostnames (space-separated) served via the Cloudflare tunnel.
# Avoid a bare *.ahamsys.com wildcard: it would capture pwms.ahamsys.com,
# which currently relies on PWMS being the default_server.
SIS_WEB_HOSTS="tajione.ahamsys.com pvns.ahamsys.com"
AMS_WEB_HOSTS="tajiams.ahamsys.com school-ams.ahamsys.com"
